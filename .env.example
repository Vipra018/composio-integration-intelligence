# ==============================================================================
# Integration Intelligence - Environment Configuration
# ==============================================================================
# Copy this file to .env and configure appropriate values before running agents.
# NEVER commit .env to version control.
# ==============================================================================

# Execution Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/integration_intelligence.log

# LLM Provider Configuration
# Supported providers: openai, anthropic, google
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2500

# Composio Integration Configuration
COMPOSIO_API_KEY=your_composio_api_key_here
COMPOSIO_BASE_URL=https://backend.composio.dev/api/v1
COMPOSIO_ENTITY_ID=default

# Research Agent Concurrency & Throttling
MAX_CONCURRENT_RESEARCH_TASKS=5
REQUEST_TIMEOUT_SECONDS=30
RATE_LIMIT_DELAY_SECONDS=1.0
MAX_SEARCH_RESULTS_PER_QUERY=5

# Browser Verification Configuration
HEADLESS_BROWSER=true
BROWSER_TIMEOUT_MS=15000

# Storage Paths
DATASET_PATH=data/apps.json
RESULTS_DIR=data/results
REPORTS_DIR=reports
